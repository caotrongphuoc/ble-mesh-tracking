/*
 * [SECURITY] Partition copy of promicro_nrf52840_nrf52840_uf2.overlay,
 * dedicated to MCUboot's own build (not the "beacon" app).
 *
 * WHY A SEPARATE FILE: Zephyr auto-applies boards/<board>.overlay only
 * to the main app. MCUboot is a COMPLETELY SEPARATE Zephyr app that
 * sysbuild builds in its own directory, so the overlay must be passed
 * explicitly via mcuboot_EXTRA_DTC_OVERLAY_FILE (see
 * sysbuild/CMakeLists.txt).
 *
 * DO NOT share a file with the app: "chosen { zephyr,code-partition }"
 * must DIFFER between the two - MCUboot must link into boot_partition
 * (0x26000) while the app must link into slot0_partition (0x32000).
 * Sharing would make MCUboot link into slot0 and overwrite the app
 * itself.
 *
 * (Note the 0x26000 base - DIFFERENT from XIAO at 0x27000. See the
 * full explanation in promicro_nrf52840_nrf52840_uf2.overlay.)
 *
 * This file ONLY declares partitions; no ADC / zephyr,user node - 
 * MCUboot does not read the battery, adding one would only bloat the
 * bootloader.
 */

/delete-node/ &reserved_partition_0;
/delete-node/ &code_partition;
/delete-node/ &storage_partition;
/delete-node/ &boot_partition;

/ {
	chosen {
		zephyr,code-partition = &boot_partition;
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		reserved_partition_0: partition@0 {
			label = "reserved";
			reg = <0x00000000 0x00026000>;
		};

		boot_partition: partition@26000 {
			label = "mcuboot";
			reg = <0x00026000 0x0000c000>;
		};

		slot0_partition: partition@32000 {
			label = "image-0";
			reg = <0x00032000 0x000ba000>;
		};

		storage_partition: partition@ec000 {
			label = "storage";
			reg = <0x000ec000 0x00008000>;
		};

		uf2_partition: partition@f4000 {
			label = "UF2";
			read-only;
			reg = <0x000f4000 0x0000c000>;
		};
	};
};
