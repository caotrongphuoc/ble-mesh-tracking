/*
 * [SECURITY + POWER] MCUboot partition layout + battery-read setup - 
 * Tag ProMicro nRF52840 (nice!nano v2-compatible, e.g. "Nologo
 * ProMicro nRF52840").
 *
 * ===== KEY DIFFERENCES VS THE XIAO VARIANT =====
 *
 * 1) DIFFERENT APP BASE ADDRESS (0x26000 vs 0x27000):
 *    ProMicro uses the Adafruit UF2 bootloader built for SoftDevice
 *    s140 *v6* (zephyr: nrf52840_partition_uf2_sdv6.dtsi), so the
 *    bootloader jumps to 0x26000. XIAO uses s140 *v7* -> jumps to
 *    0x27000. Put MCUboot at the wrong address and the board never
 *    boots the app.
 *
 * 2) BATTERY READ WITHOUT AN EXTERNAL DIVIDER:
 *    XIAO: battery -> BQ25101 -> external LDO; read via a 1M/510k
 *    divider brought out to P0.31 (AIN7), P0.14 must be driven LOW
 *    to close the measurement path.
 *    ProMicro / nice!nano v2: battery wires DIRECTLY into VDDH, no
 *    external divider - read the voltage via the SAADC's internal
 *    VDDHDIV5 input (= VDDH / 5). No enable pin required, and none
 *    of the Seeed over-voltage warnings for P0.14 apply.
 *
 * Layout (similar to XIAO but shifted down by 0x1000):
 *   0x00000 - 0x26000  reserved         (old SoftDevice region, unused)
 *   0x26000 - 0x32000  boot_partition   (MCUboot, 48 KB)
 *   0x32000 - 0xEC000  slot0_partition  (app, ~744 KB - single-slot)
 *   0xEC000 - 0xF4000  storage_partition (32 KB)
 *   0xF4000 - 0x100000 uf2_partition    (Adafruit bootloader - UNTOUCHED)
 */

/delete-node/ &reserved_partition_0;
/delete-node/ &code_partition;
/delete-node/ &storage_partition;
/delete-node/ &boot_partition;

/ {
	chosen {
		zephyr,code-partition = &slot0_partition;
	};

	/* [POWER] Battery read via the internal VDDHDIV5 (VDDH / 5) - 
	 * see the top of file. No external io-channel to declare.
	 *
	 * [POWER] ext-vcc-gpios = SOFT SWITCH that gates the external
	 * VCC pin (P0.13). This board (standard nice!nano v2) has a
	 * MOSFET between the regulator and the external 3.3 V VCC pin,
	 * controlled by P0.13:
	 *     P0.13 HIGH -> VCC ON  |  P0.13 LOW -> VCC OFF
	 * (nice!nano v1 was inverted - v2 and this clone are
	 * active-high.)
	 *
	 * The Zephyr promicro_nrf52840 board definition does NOT
	 * declare this pin, so it stays in the reset state
	 * (input / disconnected) -> the switch defaults to "on" -> the
	 * external VCC rail is always powered, even when the app uses
	 * nothing. Per the SuperMini board's own datasheet, default
	 * standby is ~1000 uA (1 mA); turning this switch off brings
	 * it down to ~150 uA.
	 *
	 * => Matches what we saw: current measured 1.8-1.9 mA and
	 *    would NOT budge no matter what we changed (log off, USB
	 *    buffer resized, uart0 / i2c0 / i2c1 / spi2 disabled) - 
	 *    because the leak was on external hardware, not something
	 *    firmware could touch.
	 *
	 * The beacon app powers no external device -> shut it off
	 * completely to save current.
	 */
	zephyr,user {
		io-channels = <&adc 0>;
		ext-vcc-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		reserved_partition_0: partition@0 {
			label = "reserved";
			reg = <0x00000000 0x00026000>;
		};

		boot_partition: partition@26000 {
			label = "mcuboot";
			reg = <0x00026000 0x0000c000>;
		};

		slot0_partition: partition@32000 {
			label = "image-0";
			reg = <0x00032000 0x000ba000>;
		};

		storage_partition: partition@ec000 {
			label = "storage";
			reg = <0x000ec000 0x00008000>;
		};

		uf2_partition: partition@f4000 {
			label = "UF2";
			read-only;
			reg = <0x000f4000 0x0000c000>;
		};
	};
};

/* [POWER] USB NOTE - do NOT disable here; disable via Kconfig.
 *
 * The board includes <boards/common/usb/cdc_acm_serial.dtsi>, which
 * creates board_cdc_acm_uart under &zephyr_udc0 and points chosen
 * zephyr,console at it. The USB stack draws ~0.8 mA continuously
 * (nearly half of the total), so it must be dropped in the production
 * build - but drop it with **CONFIG_BOARD_SERIAL_BACKEND_CDC_ACM=n**
 * in prj.conf, NOT by disabling the usbd node here.
 *
 * Reason: overlays under boards/ apply to EVERY build. Disabling the
 * usbd node here would break the debug.conf build (re-enables console
 * to read logs) - CONFIG_CONSOLE=y with no UART device to output to
 * leaves you with no COM port. Been caught by this before. Controlling
 * it through Kconfig lets each build enable / disable independently.
 */

/* [POWER TEST] Disable uart0 / i2c0 / i2c1 / spi2 - the board enables
 * these four peripherals with real pinctrl assignments, but the app
 * never touches them, so they may be FLOATING. Suspected as the
 * source of the stubborn ~1.9 mA that would not drop even after
 * disabling logs and resizing the USB buffer.
 * >> ACTUAL MEASUREMENT: no meaningful change (1.9 -> 1.8 mA, within
 *    meter noise). So this is NOT the culprit. Kept the change anyway
 *    because disabling unused peripherals is the right thing to do
 *    and causes no harm.
 * The console still runs over its own USB CDC-ACM path
 * (zephyr_udc0), independent of this physical uart0, so no logs are
 * lost. pwm0 is left alone because it is used by "red_pwm_led" (a
 * status LED). */
&uart0 {
	status = "disabled";
};

&i2c0 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/* Channel 0 maps to the SAADC's internal VDDHDIV5 = VDDH / 5
	 * (no GPIO - the LiPo cell wires straight into VDDH on this
	 * board).
	 *
	 * Gain 1/2 + internal 0.6 V reference -> ADC input range =
	 * 0.6 * 2 = 1.2 V. A LiPo cell at 3.0-4.2 V gives VDDHDIV5
	 * 0.60-0.84 V: fits comfortably in the range with good
	 * resolution (~70% of full-scale at a full cell). Under USB,
	 * VDDH may climb to ~5.5 V -> 1.1 V, still under 1.2 V so no
	 * saturation. (Gain 1/6, as XIAO uses, would waste ~3/4 of
	 * the range here.)
	 *
	 * The source is a low-impedance internal divider, so it does
	 * NOT need the 40 us acquisition time the XIAO variant uses
	 * (which must compensate for the ~342k of the external
	 * divider). The default 10 us is plenty. */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_2";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_VDDHDIV5>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
	};
};
