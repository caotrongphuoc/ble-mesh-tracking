/*
 * [SECURITY] Partition copy of xiao_ble_nrf52840.overlay, dedicated
 * to MCUboot's own build (not the "beacon" app).
 *
 * WHY A SEPARATE FILE: Zephyr auto-applies boards/xiao_ble_nrf52840.overlay
 * only to the main app (beacon). MCUboot is a COMPLETELY SEPARATE
 * Zephyr app that sysbuild builds in its own directory
 * (bootloader/mcuboot/boot/zephyr), so the overlay must be passed
 * explicitly via mcuboot_EXTRA_DTC_OVERLAY_FILE (see
 * sysbuild/CMakeLists.txt).
 *
 * DO NOT share a file with the app: "chosen { zephyr,code-partition }"
 * must DIFFER between the two - MCUboot must link into boot_partition
 * (0x27000) while the app must link into slot0_partition (0x33000).
 * Sharing (a single chosen line) would make MCUboot link into
 * slot0_partition and overwrite the app itself - this actually
 * happened during a test build (0x33000 collision between the two
 * .hex files).
 */

/delete-node/ &reserved_partition_0;
/delete-node/ &code_partition;
/delete-node/ &storage_partition;
/delete-node/ &boot_partition;

/ {
	chosen {
		zephyr,code-partition = &boot_partition;
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		reserved_partition_0: partition@0 {
			label = "reserved";
			reg = <0x00000000 0x00027000>;
		};

		boot_partition: partition@27000 {
			label = "mcuboot";
			reg = <0x00027000 0x0000c000>;
		};

		slot0_partition: partition@33000 {
			label = "image-0";
			reg = <0x00033000 0x000b9000>;
		};

		storage_partition: partition@ec000 {
			label = "storage";
			reg = <0x000ec000 0x00008000>;
		};

		uf2_partition: partition@f4000 {
			label = "UF2";
			read-only;
			reg = <0x000f4000 0x0000c000>;
		};
	};
};
